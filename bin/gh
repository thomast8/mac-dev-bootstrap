#!/bin/sh
# Pin gh to the repo's account via `git config wlaunch.ghaccount`.
# Installed to ~/.local/bin/gh (ahead of homebrew's gh on PATH) by the
# orchestrator's setup. The global gitconfig sets the personal default; the
# includeIf work layer overrides it per repo, so gh automatically uses the
# right token no matter which account is "active".
REAL_GH=/opt/homebrew/bin/gh
[ -x "$REAL_GH" ] || REAL_GH=/usr/local/bin/gh

# Respect an explicit token, and keep auth management on the real accounts.
if [ -n "$GH_TOKEN" ] || [ -n "$GITHUB_TOKEN" ] || [ "$1" = "auth" ]; then
  exec "$REAL_GH" "$@"
fi

account=$(git config --get wlaunch.ghaccount 2>/dev/null)
if [ -n "$account" ]; then
  token=$("$REAL_GH" auth token -u "$account" 2>/dev/null)
  if [ -n "$token" ]; then
    GH_TOKEN=$token exec "$REAL_GH" "$@"
  fi
fi
exec "$REAL_GH" "$@"
